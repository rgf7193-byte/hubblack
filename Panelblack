local function getScaleMultiplier(scale)
	local n13 = tonumber(scale) or 1
	if n13 <= 5 then return n13 ^ 1.85 end
	return (n13 / 5) ^ 1.2 * 19.637875755794113
end

_G.FormatNumber = function(num)
	local n13 = tonumber(num) or 0
	local n14 = math.abs(n13)
	for _, v16 in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1000000, "M" }, { 1000, "K" } }) do
		if n14 >= v16[1] then
			return (string.format("%.2f", n13 / v16[1]):gsub("(%..-)0+$", "%1"):gsub("%.$", "")) .. v16[2]
		end
	end
	return tostring(math.floor(n13 + 0.5))
end

_G.GetEggData = function(record)
	local v16 = Assets and Assets.Directory and Assets.Directory[record.AssetCategory]
	if not v16 then return nil end

	local n13 = tonumber(v16.EarningRate) or 0
	local n14 = tonumber(record.AssetScale) or 1
	local n15 = 1

	if Mutations and type(Mutations.EarningsFor) == "function" then
		local ok, result = pcall(Mutations.EarningsFor, record.Mutations)
		if ok then n15 = tonumber(result) or 1 end
	end

	local n16 = n13 * getScaleMultiplier(n14) * n15
	local color = Color3.fromRGB(170, 190, 178)
	local str2 = "COMUM"

	if v16.Rarity then
		str2 = v16.Rarity.DisplayName or v16.Rarity.Name or ""
		local rarities = Rarity and Rarity.Rarities or {}
		local dadosRaridade = rarities[v16.Rarity.Name or ""]
		local value = dadosRaridade and dadosRaridade.Color
		if typeof(value) == "ColorSequence" then
			color = value.Keypoints[1].Value
		elseif typeof(value) == "Color3" then
			color = value
		end
	end

	return {
		Uid = record.Uid,
		Category = record.AssetCategory,
		Name = v16.DisplayName or record.AssetCategory,
		Generation = math.round(n16),
		Position = record.BottomCFrame.Position,
		RarityName = string.upper(str2),
		RarityColor = color,
	}
end
