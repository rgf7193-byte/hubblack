            local dataPet = _G.GetEggData(record)
            if dataPet then
                local dist = (dataPet.Position - _G.MinhaPosicao).Magnitude
                table.insert(eggs, {Data = dataPet, Dist = dist})
                _G.LennonEggsList[dataPet.Uid] = {
