local function getMonsterPart(obj)
    if obj.Name == "Candy Corn" or (obj.Parent and obj.Parent.Name == "Monsters") then
        local mIn = obj:FindFirstChildOfClass("Model") or obj
        if mIn:IsA("Model") then
            if mIn.PrimaryPart then return mIn.PrimaryPart end
            for _, p in pairs(mIn:GetChildren()) do if p:IsA("BasePart") then return p end end
        elseif mIn:IsA("BasePart") then return mIn end
    end
    return nil
end

local function scanSingleTarget()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp, closest, short = char.HumanoidRootPart, nil, math.huge
    local mFolder = Workspace:FindFirstChild("Monsters")
    if mFolder then for _, o in pairs(mFolder:GetChildren()) do local t = getMonsterPart(o) if t then local d = (hrp.Position - t.Position).Magnitude if d < short then short = d closest = t end end end end
    if not closest then for _, o in pairs(Workspace:GetDescendants()) do local t = getMonsterPart(o) if t then local d = (hrp.Position - t.Position).Magnitude if d < short then short = d closest = t end end end end
    return closest
end

