local function checarColisaoComTapete(hrpPart)
    if not _G.TapeteESP or not _G.TapeteESP.Parent then return false end
    local posLocal = _G.TapeteESP.CFrame:PointToObjectSpace(hrpPart.Position)
    local tamanho = _G.TapeteESP.Size
    return math.abs(posLocal.X) <= (tamanho.X / 2) and math.abs(posLocal.Z) <= (tamanho.Z / 2)
end

-- Mantém a função original de obter o bastão para equipar automaticamente
local function obterBastaoAtual()
    local char = LocalPlayer.Character
    local bp = LocalPlayer.Backpack
    local padrao = "%[X%d+%]"
    if bp then 
        for _, i in pairs(bp:GetChildren()) do 
            if i:IsA("Tool") and string.find(i.Name, padrao) then 
                local black = false 
                for _, p in ipairs(listaNegraUtilitarios) do if string.find(string.lower(i.Name), string.lower(p)) then black = true end end 
                if not black then return i end 
            end 
        end 
    end
    if char then 
        for _, i in pairs(char:GetChildren()) do 
            if i:IsA("Tool") and string.find(i.Name, padrao) then 
                local black = false 
                for _, p in ipairs(listaNegraUtilitarios) do if string.find(string.lower(i.Name), string.lower(p)) then black = true end end 
                if not black then return i end 
            end 
        end 
    end
    return nil
end

