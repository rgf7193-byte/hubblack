RunService.Heartbeat:Connect(function(dt)
    if not _G.ToggleState then currentTargetPart = nil fustigoFugaAtivo = false _G.AguardandoSeguranca = false return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not hrp or not hum or hum.Health <= 0 then return end
    if _G.AguardandoSeguranca then return end
    
    local estaRelandoNoESP = checarColisaoComTapete(hrp)
    
    if estaRelandoNoESP then
        fustigoFugaAtivo = true
        currentTargetPart = nil
    else
        fustigoFugaAtivo = false
    end
    
    if fustigoFugaAtivo then
        local cPos = hrp.Position
        local vecEscape = PontoEscape - cPos
        
        if vecEscape.Magnitude > 3 then
            -- Configura a velocidade nativa de corrida para 200 de forma segura
            hum.WalkSpeed = 200
            -- Executa a corrida real pelo chão até o ponto seguro
            hum:MoveTo(PontoEscape)
        else
            -- Chegou na coordenada: limpa a fuga e inicia os 3 segundos
            fustigoFugaAtivo = false
            _G.AguardandoSeguranca = true
            hum:MoveTo(cPos) -- Força a parada imediata dos pés
            
            task.spawn(function()
                task.wait(3)
                _G.AguardandoSeguranca = false
            end)
        end
    else
        -- CAÇA NORMAL DOS MONSTROS ORIGINAL POR CFRAME (Mantendo 5 studs de distância)
        if not currentTargetPart or not currentTargetPart:IsDescendantOf(Workspace) then currentTargetPart = scanSingleTarget() end
        if currentTargetPart then
            local tPosRaw = currentTargetPart.Position
            local cPos = hrp.Position
            local tPos = Vector3.new(tPosRaw.X, cPos.Y, tPosRaw.Z)
            
            local vec = tPos - cPos
            local distanciaAtual = vec.Magnitude
            
            if distanciaAtual > 5 then
                local direcao = vec.Unit
                local pontoParada = tPos - (direcao * 5)
                local vetorAtePonto = pontoParada - cPos
                local step = _G.ModdedSpeed * dt 
                if step >= vetorAtePonto.Magnitude then 
                    hrp.CFrame = CFrame.new(pontoParada, Vector3.new(tPos.X, cPos.Y, tPos.Z)) 
                else 
                    hrp.CFrame = CFrame.new(cPos + (direcao * step), Vector3.new(tPos.X, cPos.Y, tPos.Z)) 
                end
            else
                hrp.CFrame = CFrame.new(cPos, Vector3.new(tPos.X, cPos.Y, tPos.Z))
            end
        end
    end
end)

