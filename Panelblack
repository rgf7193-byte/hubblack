-- Define a rotina avançada pós-coleta acionada pelo motor físico
_G.ProcessarTrajetoCompletoLennon = function(ovoID, meuHrp, humanoid, playerGui, player, character)
    local coordenadaIntermediaria = Vector3.new(613.4, 70.6, -304.3) -- Parada 1
    local coordenadaFinal = Vector3.new(499.2, 70.6, -295.1)        -- Parada Final
    local velocidadeEtapa1 = 4500                                    -- Velocidade inicial até a intermediária
    local velocidadeEtapa2 = 300                                     -- Velocidade da última corrida
    local conexaoNovaPrompt = nil

    -- Rotina de cliques na interface de drop do jogo
    local function executarScriptBotao()
        for _, objeto in ipairs(playerGui:GetDescendants()) do
            if objeto.Name == "DropHeldEgg" then
                local botao = objeto:FindFirstChild("Button")
                if botao then
                    local conexoes = getconnections(botao.MouseButton1Click)
                    if #conexoes > 0 then
                        for _, conexao in ipairs(conexoes) do conexao:Fire() end
                    else
                        local conexoesAtivadas = getconnections(botao.Activated)
                        for _, conexao in ipairs(conexoesAtivadas) do conexao:Fire() end
                    end
                    break
                end
            end
        end
    end

    -- Método Otimizado: Remove Cooldown e suga o ProximityPrompt na hora!
    local function executarSistemaPrompts()
        local function extrairPrompt(prompt)
            if prompt:IsA("ProximityPrompt") then
                prompt.HoldDuration = 0 
                task.spawn(function()
                    while _G.ActiveSteals[ovoID] and prompt and prompt.Parent do
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (player.Character.HumanoidRootPart.Position - prompt.Parent:GetPivot().Position).Magnitude
                            if distance <= prompt.MaxActivationDistance then 
                                fireproximityprompt(prompt) -- Coleta instantânea do novo bicho
                            end
                        end
                        task.wait(0.05)
                    end
                end)
            end
        end

        for _, desc in pairs(workspace:GetDescendants()) do extrairPrompt(desc) end
        conexaoNovaPrompt = workspace.DescendantAdded:Connect(extrairPrompt)
    end

    -- GATILHO DE IMORTALIDADE: Desacopla o humanoid original do jogo temporariamente
    local humanoidOriginal = humanoid
    humanoidOriginal.Parent = nil 

    local fakeHumanoid = Instance.new("Humanoid")
    fakeHumanoid.Parent = character
    
    local targetCFrame = meuHrp.CFrame
    
    -- Loop Heartbeat Estável: Gruda na coordenada frame por frame e zera forças físicas
    local loopTravaHeartbeat
    loopTravaHeartbeat = RunService.Heartbeat:Connect(function()
        if not _G.ActiveSteals[ovoID] then
            if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
            return
        end
        if meuHrp and meuHrp.Parent then
            meuHrp.CFrame = targetCFrame
            meuHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)  -- Zera gravidade/queda
            meuHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0) -- Zera rotações indesejadas
            if fakeHumanoid and fakeHumanoid.Parent then fakeHumanoid.Health = 100 end
        else
            if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
        end
    end)

    -- Motor do Teleport com Avanço Linear Constante Baseado em CFrame
    local function moverComHeartbeat(destino, velocidade)
        local startPos = targetCFrame.Position
        local distance = (destino - startPos).Magnitude
        if distance == 0 then return end
        local duracao = distance / velocidade
        local startTime = tick()
        
        while tick() - startTime < duracao do
            if not _G.ActiveSteals[ovoID] then return end
            local elapsed = tick() - startTime
            local progress = math.clamp(elapsed / duracao, 0, 1)
            targetCFrame = CFrame.new(startPos:Lerp(destino, progress)) * targetCFrame.Rotation
            task.wait()
        end
        targetCFrame = CFrame.new(destino) * targetCFrame.Rotation
    end

    -- ETAPA 1: Teleport constante até a coordenada intermediária
    if _G.ActiveSteals[ovoID] then
        moverComHeartbeat(coordenadaIntermediaria, velocidadeEtapa1)
    end

    -- CHEGOU NA INTERMEDIÁRIA: Sincronização dos tempos com a trava de física ativa
    if _G.ActiveSteals[ovoID] then
        task.wait(0.20)          
        executarScriptBotao()    
        task.wait(0.40)          
        executarSistemaPrompts() 
        task.wait(0.50)          
    end

    -- ETAPA 2: Arranque teleguiado a 300 de velocidade até a coordenada final do mapa
    if _G.ActiveSteals[ovoID] then
        moverComHeartbeat(coordenadaFinal, velocidadeEtapa2)
    end

    if conexaoNovaPrompt then
        conexaoNovaPrompt:Disconnect()
        conexaoNovaPrompt = nil
    end
    
    -- LIMPEZA DOS GATILHOS DE TRAVA E DO HUMANÓIDE FAKE
    if loopTravaHeartbeat then loopTravaHeartbeat:Disconnect() end
    if fakeHumanoid then fakeHumanoid:Destroy() end
    
    meuHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    task.wait(0.05)
    
    -- RESTAURAÇÃO: Devolve o seu Humanoid original 100% de volta ao normal no ponto final
    humanoidOriginal.Parent = character
    workspace.CurrentCamera.CameraSubject = humanoidOriginal
    
    meuHrp.CFrame = CFrame.new(coordenadaFinal) * targetCFrame.Rotation
    
    _G.ActiveSteals[ovoID] = false
    _G.CooldownFarm = tick() + 0.3
end

-- Motor Teleguiado principal de aproximação até o bicho selecionado
_G.ExecutarTeleguiadoLennon = function()
    if not _G.AutoFarmAtivo or tick() < _G.CooldownFarm then return end
    
    -- 🌟 MODIFICAÇÃO CHAVE: Bloqueia o avanço e a atualização se não houver NENHUM bicho explicitamente selecionado
    if not _G.BichoSelecionadoUid then 
        task.wait(0.2)
        return 
    end

    if type(_G.AtuaisModelos) == "function" then
        _G.AtuaisModelos()
    end

    local ListaAlvos = _G.LennonEggsList or {}
    local melhorAlvoUid = nil
    local posicaoAlvo = nil

    -- Filtro rígido baseado estritamente na caixinha selecionada única no painel Neon
    if ListaAlvos[_G.BichoSelecionadoUid] then
        local bicho = ListaAlvos[_G.BichoSelecionadoUid]
        melhorAlvoUid = bicho.Uid
        posicaoAlvo = bicho.Position
    end

    if melhorAlvoUid and posicaoAlvo then
        local player = game.Players.LocalPlayer
        local character = player.Character
        local meuHrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local playerGui = player:FindFirstChildOfClass("PlayerGui")

        if meuHrp and humanoid and playerGui then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bv.Parent = meuHrp

            local destinoOvo = posicaoAlvo + Vector3.new(0, 2, 0)
            
            while _G.AutoFarmAtivo and _G.BichoSelecionadoUid == melhorAlvoUid and (destinoOvo - meuHrp.Position).Magnitude > 3 do
                local direcao = (destinoOvo - meuHrp.Position).Unit
                bv.Velocity = direcao * 300
                task.wait()
            end

            bv:Destroy()
            meuHrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.40)

            -- Verifica se o farm continua ativo e se o bicho ainda é o selecionado antes de disparar as ações
            if _G.AutoFarmAtivo and _G.BichoSelecionadoUid == melhorAlvoUid then
                local ovoID = melhorAlvoUid
                if not _G.ActiveSteals then _G.ActiveSteals = {} end
                _G.ActiveSteals[ovoID] = true

                local carryRemote = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Networking"):WaitForChild("RF/EggWorld/AskFieldEggCarry", 5)
                if carryRemote then
                    pcall(function() carryRemote:InvokeServer({ Uid = ovoID }) end)
                end

                if type(_G.ProcessarTrajetoCompletoLennon) == "function" then
                    _G.ProcessarTrajetoCompletoLennon(ovoID, meuHrp, humanoid, playerGui, player, character)
                else
                    _G.ActiveSteals[ovoID] = false
                    _G.CooldownFarm = tick() + 0.3
                end
            end
        end
    else
        task.wait(0.5)
    end
end
